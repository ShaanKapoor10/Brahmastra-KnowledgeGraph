# Brahmastra production settings. Copy to .env.production (setup.sh does),
# keep it at mode 600, and never commit it. setup.sh fills every empty secret
# below with a random value and never prints one.
#
# The backend refuses to start (brahmastra/preflight.py) if a secret is empty,
# a known default or too short, if anonymous access is on, or if CORS allows "*".

# ---- release -----------------------------------------------------------------
# Pinned. upgrade.sh changes this; a restart never changes what runs.
BRAHMASTRA_VERSION=0.2.0

# ---- where it is served --------------------------------------------------------
DOMAIN=kb.example.com
PUBLIC_URL=https://kb.example.com
# Your email for Let's Encrypt, or "internal" for a test install (Caddy's own CA).
CADDY_TLS=admin@example.com
# Change only if 80/443 are taken (e.g. a local trial).
HTTP_PORT=80
HTTPS_PORT=443
TZ=UTC

# ---- secrets (generated by setup.sh when empty) -------------------------------
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# Optional legacy service key, for a scheduler or local MCP server talking to
# this install. People should use personal tokens instead.
BRAHMASTRA_API_KEY=
# Optional: allows creating the first admin over HTTPS (POST /v1/auth/setup)
# on a host without a shell. Remove it once the admin exists.
BRAHMASTRA_SETUP_TOKEN=

# ---- language model ------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEYS=
GROQ_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- optional integrations -----------------------------------------------------
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Serve MCP over HTTPS at /v1/mcp (admin tokens only, for now).
MCP_HTTP=

# ---- capacity -------------------------------------------------------------------
# Sized for a 4 GB host. Neo4j: heap + page cache + ~0.5 GB must fit NEO4J_MEMORY.
WEB_CONCURRENCY=2
BACKEND_MEMORY=2g
POSTGRES_MEMORY=1g
NEO4J_MEMORY=2g
NEO4J_HEAP=512m
NEO4J_PAGECACHE=512m
RATE_LIMITS=

# ---- backups (3-2-1: live database, local dumps, encrypted off-host copy) ------
# restic encrypts everything client-side with RESTIC_PASSWORD. LOSE IT AND THE
# BACKUPS ARE UNREADABLE: store it in your password manager, away from this host.
RESTIC_REPOSITORY=s3:https://s3.amazonaws.com/your-bucket/brahmastra
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# "off" skips the off-host copy. Not for production: one disk is not a backup.
BACKUP_OFFSITE=on
# Daily backup (local time, TZ above) and the weekly restore test (1=Mon .. 7=Sun).
BACKUP_TIME=02:30
RESTORE_TEST_WEEKDAY=7
RESTORE_TEST_TIME=04:00
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12

# ---- alerting ---------------------------------------------------------------------
# A webhook that accepts {"text": "..."}: Slack and Microsoft Teams incoming
# webhooks both do. Receives every backup or restore-test failure.
ALERT_WEBHOOK_URL=
# Dead-man's switches (healthchecks.io, Better Stack, Cronitor): pinged on
# success, so a backup that silently stops running still raises an alarm.
BACKUP_HEARTBEAT_URL=
RESTORE_TEST_HEARTBEAT_URL=

# ---- monitoring (opt-in) -------------------------------------------------------------
# Set COMPOSE_PROFILES=monitoring to run Prometheus, Alertmanager, Grafana,
# node_exporter and cAdvisor beside the app (docs/OBSERVABILITY.md). Keep the
# external uptime check on /healthz either way: it is the view from outside.
COMPOSE_PROFILES=
# Where alerts go: slack | msteams | webhook, and that receiver's URL. Required
# when monitoring is on: Alertmanager refuses to start without a receiver.
ALERT_RECEIVER=slack
# (ALERT_WEBHOOK_URL above is shared with the backup job's alerts.)
# Optional dead-man's switch for the always-firing Watchdog alert.
WATCHDOG_URL=
# Generated by setup.sh. Grafana listens on 127.0.0.1 only (SSH tunnel).
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
# Only on Docker Desktop (a trial on a laptop): it cannot propagate host mounts.
# NODE_EXPORTER_MOUNT=ro
