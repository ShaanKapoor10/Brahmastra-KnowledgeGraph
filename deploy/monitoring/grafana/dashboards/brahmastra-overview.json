{
 "uid": "brahmastra-overview",
 "title": "Brahmastra overview",
 "tags": [
  "brahmastra"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "links": [
  {
   "title": "Runbook",
   "type": "link",
   "url": "https://github.com/ShaanKapoor10/Brahmastra-KnowledgeGraph/blob/main/docs/RUNBOOK.md",
   "targetBlank": true
  }
 ],
 "panels": [
  {
   "type": "row",
   "title": "Service health  (objectives: docs/RELIABILITY.md)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "API",
   "description": "Prometheus can scrape the backend.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"brahmastra\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Graph engine",
   "description": "When down the product is DEGRADED: notes, search and Ask work; the dashboard shows the saved graph.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "brahmastra_graph_up",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Availability (30 d)",
   "description": "Objective: 99.5% of API requests succeed.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - (sum(increase(brahmastra_http_requests_total{route!~\"/health.*|/metrics|/ask|/pipeline/.*|/ingest/transcripts.*\",status_class=\"5xx\"}[30d])) / clamp_min(sum(increase(brahmastra_http_requests_total{route!~\"/health.*|/metrics|/ask|/pipeline/.*|/ingest/transcripts.*\"}[30d])), 1))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.99
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Error budget left (30 d)",
   "description": "Share of the 0.5% monthly error budget not yet spent. Exhausted = feature freeze (error-budget policy).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - ((sum(increase(brahmastra_http_requests_total{route!~\"/health.*|/metrics|/ask|/pipeline/.*|/ingest/transcripts.*\",status_class=\"5xx\"}[30d])) / clamp_min(sum(increase(brahmastra_http_requests_total{route!~\"/health.*|/metrics|/ask|/pipeline/.*|/ingest/transcripts.*\"}[30d])), 1)) / 0.005)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 5
  },
  {
   "type": "stat",
   "title": "API p95 latency",
   "description": "Objective: 99% of API requests within 1.5 s.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "brahmastra:api_p95_latency_seconds:rate5m",
