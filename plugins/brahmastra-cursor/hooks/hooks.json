{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node hooks/brahmastra-hook.mjs cursor",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node hooks/brahmastra-hook.mjs cursor",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node hooks/brahmastra-hook.mjs cursor",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node hooks/brahmastra-hook.mjs cursor",
        "timeout": 15,
        "loop_limit": 1
      }
    ]
  }
}
